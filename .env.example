VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Supabase Edge Function secrets (never prefix these with VITE_)
# Use a least-privilege Stripe restricted key, not a secret key, when possible.
STRIPE_RESTRICTED_KEY=rk_live_your_restricted_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRICE_LOOKUP_KEYS=lead_spark_98_growth_monthly,lead_spark_98_pro_monthly
APP_URL=https://your-production-domain.example

# Automated sales force
# The shared scheduler credential lives in Supabase Vault as
# lead_spark_sales_orchestrator_secret. Do not duplicate it here.
RESEND_API_KEY=re_your_resend_api_key
SALES_FROM_EMAIL=Rivet Reach <sales@your-verified-domain.example>
SALES_BUSINESS_NAME=Rivet Reach
SALES_POSTAL_ADDRESS=your-valid-physical-mailing-address
RIVET_REACH_SIGNUP_URL=https://rivetreach.com/login
RIVET_REACH_PRIVACY_URL=https://rivetreach.com/privacy
